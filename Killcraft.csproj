<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Killcraft</AssemblyName>
    <!-- The mod's version, in the dll too (the launcher reads it): keep it the same as Plugin.cs's BepInPlugin. -->
    <Version>2.0.2</Version>
    <RootNamespace>Killcraft</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Your ULTRAKILL folder. If it isn't one of these: dotnet build -c Release -p:GameDir="X:\path\to\ULTRAKILL" -->
    <GameDir Condition="'$(GameDir)' == '' And Exists('D:\SteamLibrary\steamapps\common\ULTRAKILL')">D:\SteamLibrary\steamapps\common\ULTRAKILL</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ULTRAKILL</GameDir>
    <Managed>$(GameDir)\ULTRAKILL_Data\Managed</Managed>
    <PluginDir>$(GameDir)\BepInEx\plugins\Killcraft</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher and the Minecraft mod are their own projects in this repo. -->
    <Compile Remove="launcher/**;mcmod/**;design/**" />
    <None Remove="launcher/**;mcmod/**;design/**" />
  </ItemGroup>

  <!-- KillNet alone (dotnet build -c Release -p:KillNetOnly=true): the multiplayer without anything of
       Minecraft's. Left out: starting Minecraft, the link to it (shared memory, its local port), drawing
       its world, and the second-player-on-one-PC test link. Only Steam (lobbies and peer-to-peer). -->
  <PropertyGroup Condition="'$(KillNetOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);KILLNET_ONLY</DefineConstants>
    <AssemblyName>KillNet</AssemblyName>
    <IntermediateOutputPath>obj\$(Configuration)\killnet\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\killnet\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(KillNetOnly)' == 'true'">
    <Compile Remove="src\Collision.cs;src\Combat.cs;src\Destruction.cs;src\HeldItems.cs;src\HudHider.cs;src\InputForward.cs;src\Launcher.cs;src\Link.cs;src\Lockout.cs;src\McAudio.cs;src\McCommand.cs;src\McSave.cs;src\MobHits.cs;src\ModeChoice.cs;src\Nether.cs;src\NetherWorld.cs;src\Overlay.cs;src\Proto.cs;src\SmileOs.cs;src\WorldRender.cs;src\OwnFolders.cs;src\Net\DiscordRpc.cs;src\Net\LocalLink.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainModule" HintPath="$(Managed)\UnityEngine.TerrainModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainPhysicsModule" HintPath="$(Managed)\UnityEngine.TerrainPhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(Managed)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(Managed)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(Managed)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(Managed)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(Managed)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(Managed)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(Managed)\UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(Managed)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="Facepunch.Steamworks.Win64" HintPath="$(Managed)\Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(Managed)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build">
    <MakeDir Directories="$(PluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="second-player.bat" DestinationFolder="$(PluginDir)" Condition="'$(KillNetOnly)' != 'true'" />
    <!-- Killcraft's Minecraft mod (mcmod, built with Gradle), shipped next to the plugin. -->
    <ItemGroup>
      <ModJar Include="mcmod\build\libs\killcraft-mc-*.jar" />
    </ItemGroup>
    <Copy SourceFiles="@(ModJar)" DestinationFiles="$(PluginDir)\killcraft-mc.jar" Condition="'@(ModJar)' != '' And '$(KillNetOnly)' != 'true'" />
  </Target>
</Project>
